# QuaTrel settings for the systemd service
# Copy to /etc/quatrel.env and edit.

# Listen on every network interface so other computers on the LAN can reach QuaTrel.
QUATREL_HOST=0.0.0.0
QUATREL_PORT=5000

# Keep the database outside the program folder, so upgrades never touch it.
QUATREL_DB=/var/lib/quatrel/quatrel.db

# A password keeps casual visitors on your network out. Any user name works in
# the browser's sign-in box; only the password is checked. Leave blank for none.
QUATREL_PASSWORD=
